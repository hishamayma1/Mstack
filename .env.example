# MongoDB connection string used by the Payload CMS db adapter.
# Local dev default: mongodb://127.0.0.1:27017/mstack360
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mstack360
DATABASE_URI=mongodb://127.0.0.1:27017/mstack360

# Used by Payload to sign/encrypt auth tokens. Any long random string —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Base URL of this app, used by Payload for absolute links (e.g. in emails).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Microsoft 365 / Office 365 SMTP — used by Payload to send auth emails
# (password resets, etc.). Requires a mailbox with SMTP AUTH enabled
# (Exchange admin center > Mail flow > check "Authenticated SMTP" is on
# for the account) and, if the tenant enforces MFA, an app password
# instead of the account's normal password.
# Leave SMTP_USER/SMTP_PASS blank to keep the dev default of logging
# emails to the console instead of sending them.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MStack360

# ── New-service-request alerts ─────────────────────────────────────────────
# Who gets emailed when someone submits the configurator on /solutions/[slug].
# Comma-separate for several recipients. Leave blank to disable the email
# alert (browser push, below, is independent of this).
NOTIFY_EMAIL_TO=

# ── Browser push notifications (Web Push / VAPID) ──────────────────────────
# Free — push is delivered by the browser vendors' own services, with no
# third party involved. Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Put the SAME public key in both VAPID_PUBLIC_KEY and the NEXT_PUBLIC_ copy;
# the latter is what the browser needs to subscribe.
#
# Keep the pair stable. Regenerating it invalidates every existing
# subscription, and everyone has to switch notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact address the push service uses if a subscription misbehaves.
VAPID_SUBJECT=mailto:you@mstack360.com

# UploadThing CDN for Media uploads (uploadthing.com → your app → API Keys)
UPLOADTHING_TOKEN=
